# Warhorse — docroot único: SPA (React) + API (CodeIgniter) en el mismo origen.
# El SPA pide siempre /api/v1/... (mismo dominio), así que no hace falta CORS.

Options -Indexes
ServerSignature Off

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # ------------------------------------------------------------------
    # CRÍTICO en hosting compartido (LiteSpeed/CGI): reinyecta el header
    # Authorization, que el servidor suele descartar. Sin esto, el login
    # por token (Bearer) falla con 401 en producción.
    # ------------------------------------------------------------------
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # 0) Allow PHP runner scripts to execute directly (bypasses SPA fallback)
    RewriteCond %{REQUEST_URI} ^/run_.*\.php$
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # 1) Toda la API la maneja CodeIgniter (front controller index.php).
    #    Forzamos SCRIPT_NAME=/index.php para que CI4 no elimine /api/ del URI.
    RewriteCond %{REQUEST_URI} ^/api(/.*)?$
    RewriteRule ^ index.php [E=SCRIPT_NAME:/index.php,L]

    # 2) Rutas del Dashboard (/app/...)
    # Si la petición empieza con /app, reescribimos al index.html del dashboard dentro del subdirectorio app/
    RewriteCond %{REQUEST_URI} ^/app(/.*)?$
    # Si no es un archivo real, redirigimos al index.html de la subcarpeta app
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ app/index.html [L]

    # 3) Archivos y carpetas reales del SPA corporativo o del dashboard: directo.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 4) Cualquier otra ruta la resuelve el SPA corporativo en la raíz (React Router).
    RewriteRule ^ index.html [L]
</IfModule>

# Evita que se cachee el index.html para siempre servir el bundle correcto
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "no-referrer"
    
    # No guardar caché de index.html
    <FilesMatch "index\.html$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
    </FilesMatch>
</IfModule>

# Cachea los assets hasheados del SPA (nombres con hash = inmutables)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>
AddDefaultCharset UTF-8
